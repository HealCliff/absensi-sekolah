# Supabase (database Postgres)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role_key...

# JWT untuk sesi aplikasi (WAJIB — server tidak jalan tanpa ini. Ganti dengan secret acak yang panjang)
JWT_SECRET=ganti-dengan-random-string-panjang-minimal-32-karakter

# Origin frontend yang diizinkan (pisahkan dengan koma). Kosongkan = semua origin (hanya untuk dev)
# Contoh: CORS_ORIGIN=http://localhost:5173,https://absensi.school.id
CORS_ORIGIN=

# Konfigurasi absensi
JAM_BATAS_MASUK=07:15
JAM_BATAS_PULANG=13:00
SCHOOL_TIME_ZONE=Asia/Jakarta
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_MIN_LENGTH=8

# Port server
PORT=4000

# Backup database (gunakan connection string PostgreSQL dari Supabase)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.xxxxx.supabase.co:5432/postgres
BACKUP_DIR=./backups
# Restore hanya berjalan jika CONFIRM_RESTORE=YES dan BACKUP_FILE diisi.
BACKUP_FILE=
CONFIRM_RESTORE=
